
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.ensemble import RandomForestClassifier, VotingClassifier, BaggingClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix

# Load Dataset
df = pd.read_csv("water_potability.csv")

print("Dataset Shape:", df.shape)
print(df.head(10))

print("\nMissing Values:")
print(df.isnull().sum())

print("\nClass Distribution:")
print(df["Potability"].value_counts())

X = df.drop("Potability", axis=1)
y = df["Potability"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, stratify=y, random_state=42
)

# Handle Missing Values
imputer = SimpleImputer(strategy="median")

X_train = pd.DataFrame(
    imputer.fit_transform(X_train), columns=X.columns
)
X_test = pd.DataFrame(
    imputer.transform(X_test), columns=X.columns
)

lr = Pipeline([
    ("scaler", StandardScaler()),
    ("model", LogisticRegression(max_iter=2000, random_state=42))
])

svc = Pipeline([
    ("scaler", StandardScaler()),
    ("model", SVC(probability=True, random_state=42))
])

rf = RandomForestClassifier(n_estimators=100, random_state=42)

models = {
    "Logistic Regression": lr,
    "SVC": svc,
    "Random Forest": rf
}

for model in models.values():
    model.fit(X_train, y_train)

voting_hard = VotingClassifier(
    estimators=[("lr", lr), ("svc", svc), ("rf", rf)],
    voting="hard"
)

voting_soft = VotingClassifier(
    estimators=[("lr", lr), ("svc", svc), ("rf", rf)],
    voting="soft"
)

voting_hard.fit(X_train, y_train)
voting_soft.fit(X_train, y_train)

dt = DecisionTreeClassifier(random_state=42)
dt.fit(X_train, y_train)

bag10 = BaggingClassifier(
    estimator=DecisionTreeClassifier(random_state=42),
    n_estimators=10,
    max_samples=0.5,
    bootstrap=True,
    random_state=42
)

bag100 = BaggingClassifier(
    estimator=DecisionTreeClassifier(random_state=42),
    n_estimators=100,
    max_samples=0.5,
    bootstrap=True,
    random_state=42
)

pasting = BaggingClassifier(
    estimator=DecisionTreeClassifier(random_state=42),
    n_estimators=100,
    max_samples=0.5,
    bootstrap=False,
    random_state=42
)

bag10.fit(X_train, y_train)
bag100.fit(X_train, y_train)
pasting.fit(X_train, y_train)

all_models = {
    **models,
    "Decision Tree": dt,
    "Voting Hard": voting_hard,
    "Voting Soft": voting_soft,
    "Bagging 10": bag10,
    "Bagging 100": bag100,
    "Pasting 100": pasting
}

results = []

for name, model in all_models.items():

    pred = model.predict(X_test)

    results.append({
        "Model": name,
        "Accuracy": accuracy_score(y_test, pred),
        "Precision": precision_score(y_test, pred, zero_division=0),
        "Recall": recall_score(y_test, pred, zero_division=0),
        "F1-score": f1_score(y_test, pred, zero_division=0)
    })

results_df = pd.DataFrame(results)
results_df = results_df.sort_values("F1-score", ascending=False)

print("\nModel Comparison:")
print(results_df.to_string(index=False))

# Best Model
best_name = results_df.iloc[0]["Model"]
best_model = all_models[best_name]

best_pred = best_model.predict(X_test)

print("\nBest Model:", best_name)
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, best_pred))

# Confusion Matrix Heatmap
sns.heatmap(confusion_matrix(y_test, best_pred),
            annot=True, fmt="d", cmap="Blues")

plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Best Model Confusion Matrix")
plt.show()